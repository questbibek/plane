# Vrit Tech production .env — lives next to docker-compose.vrit.yml on the VPS.
# Copy to `.env`, fill every CHANGE_ME, and keep it OFF git (chmod 600).
# Single file feeds infra (db/mq/proxy) AND the backend containers.
# File storage is external (Cloudflare R2) — no MinIO container.

# ── Image source (CI overrides REGISTRY/IMAGE_PREFIX/APP_RELEASE at deploy) ──
REGISTRY=ghcr.io
IMAGE_PREFIX=questbibek            # your GHCR namespace (lowercase)
APP_RELEASE=vrit                  # moving tag for manual `up`; CI pins a SHA

# ── Domain / TLS (Caddy auto-issues Let's Encrypt from these) ──
SITE_ADDRESS=projects.vrittechnologies.com
CERT_EMAIL=admin@vrittechnologies.com
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# Proxy's legacy local-bucket route → a sentinel so it never hijacks a real
# path (R2 files are served from the R2 domain via presigned URLs, not here).
PROXY_BUCKET_ROUTE=__minio_disabled__

# ── Django backend ──
DEBUG=0
SECRET_KEY=CHANGE_ME_django_secret_50_random_chars
CORS_ALLOWED_ORIGINS=https://projects.vrittechnologies.com
WEB_URL=https://projects.vrittechnologies.com
GUNICORN_WORKERS=2
API_KEY_RATE_LIMIT=60/minute
HARD_DELETE_AFTER_DAYS=60
SIGNED_URL_EXPIRATION=3600
DOCKERIZED=1

# ── Database (Postgres) ──
POSTGRES_USER=plane
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_HOST=plane-db
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=postgresql://plane:CHANGE_ME_strong_db_password@plane-db:5432/plane

# ── Redis / Valkey ──
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

# ── RabbitMQ ──
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=CHANGE_ME_strong_mq_password
RABBITMQ_VHOST=plane

# ── Object storage: Cloudflare R2 (S3-compatible, external) ──
USE_MINIO=0
AWS_REGION=auto
AWS_ACCESS_KEY_ID=CHANGE_ME_r2_access_key_id
AWS_SECRET_ACCESS_KEY=CHANGE_ME_r2_secret_access_key
# Account S3 endpoint — NO bucket suffix (boto3 passes the bucket separately):
AWS_S3_ENDPOINT_URL=https://CHANGE_ME_accountid.r2.cloudflarestorage.com
AWS_S3_BUCKET_NAME=plane
FILE_SIZE_LIMIT=5242880
# Bucket CORS must allow https://projects.vrittechnologies.com (GET/PUT/POST/HEAD).

# ── Database backups → Cloudflare R2 (off-site) ──
# Sidecar dumps Postgres and uploads to its own dedicated R2 bucket, reusing the
# same R2 endpoint + credentials as the app (AWS_* above).
BACKUP_ENABLED=true
BACKUP_BUCKET=planedbbackup      # dedicated backup bucket (separate from AWS_S3_BUCKET_NAME)
BACKUP_INTERVAL_HOURS=12          # twice daily
BACKUP_KEEP_COUNT=30             # keep newest 30 (~15 days at 12h); oldest pruned over cap
BACKUP_RUN_ON_START=true         # run once ~60s after start (guarded: won't spam on restart)
BACKUP_PREFIX=                   # optional sub-path inside the bucket; empty = bucket root

# ── Live (realtime collab) ──
LIVE_SERVER_SECRET_KEY=CHANGE_ME_live_secret

# ── Internal base paths (match the Caddy proxy routes; leave as-is) ──
ADMIN_BASE_URL=https://projects.vrittechnologies.com
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=https://projects.vrittechnologies.com
SPACE_BASE_PATH=/spaces
APP_BASE_URL=https://projects.vrittechnologies.com
APP_BASE_PATH=
LIVE_BASE_URL=https://projects.vrittechnologies.com
LIVE_BASE_PATH=/live
